# ---------------------------------------------------------------------------
# Reality Lab — environment variables
# Copy this file to `.env` and fill in your own values.
# NOTHING here is required for the app to run: without Supabase it falls back to
# local (browser) storage + demo auth; without an AI key it uses the
# deterministic/probabilistic simulation engine only.
# ---------------------------------------------------------------------------

# Supabase (https://app.supabase.com -> Project Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: server-side / AI provider key, used ONLY for natural-language
# scenario parsing and human-readable explanations. Never required for numbers.
AI_API_KEY=
VITE_AI_ENDPOINT=

# Optional: public site URL (Vercel / Netlify) used for auth redirects
VITE_SITE_URL=http://localhost:5173
